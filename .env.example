# --- services/stream ---
# Arc network to index: mainnet (chain 5042) or testnet (chain 5042002). A database holds
# one network for life; the service refuses to start on a database bound to the other.
ARC_NETWORK=mainnet
# Arc RPC endpoints, comma-separated, tried in order: the ingestor fails over to the next
# when one errors, and will not start if one serves another chain. Empty: the public
# endpoints for ARC_NETWORK (docs.arc.io). Public endpoints rate-limit and can ban a host
# for hours; for anything long-running put a keyed endpoint first, e.g.
# https://arc-mainnet.g.alchemy.com/v2/<key>,https://rpc.mainnet.arc.io
ARC_RPC_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tideline
PORT=8080
# Bootstrap admin key for curating the registry. Use a long random value.
TIDELINE_ADMIN_KEY=
# Blocks to backfill behind the head on first start (Arc blocks are ~0.5s). 172800 is one
# day. The web app says so whenever a window reaches back further than the data does.
BACKFILL_BLOCKS=600
# How often the ingestor polls at the chain head. Raise it on public RPC endpoints.
POLL_INTERVAL_MS=500
# Ingest every token's transfers (true), or only the listed tokens in data/tokens.seed.json.
TRACK_ALL_TOKENS=true
# Delete flows older than this many days, checked hourly. Empty or 0 keeps everything. With
# every token tracked, Arc Mainnet adds about 1 GB of flows a day.
RETENTION_DAYS=
# Reference rates for notional USD, listed tokens only. While LIVE_RATES is on they are
# refreshed from the ECB euro reference rate and the USYC price report; these values apply
# until a source answers. cirBTC and WETH use CoinGecko spot prices and have no static
# fallback: they stay unpriced until the spot source answers.
LIVE_RATES=true
EURC_USD_RATE=1.08
USYC_USD_RATE=1.10
# topic0 of Arc's confidential-transfer event, once Arc privacy ships. Leave empty until then.
CONFIDENTIAL_TRANSFER_TOPIC=

# --- apps/web ---
TIDELINE_API_URL=http://localhost:8080
# A licensed or admin key: the web app shows attribution evidence.
TIDELINE_API_KEY=
